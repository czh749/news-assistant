# ======================================
# 智能新闻助手 - 环境变量配置模板
# ======================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# --------------------------------------
# 智谱AI配置（必填）
# --------------------------------------
# 从 https://open.bigmodel.cn/ 获取
ZHIPU_API_KEY=your_api_key_here
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_EMBEDDING_MODEL=embedding-2

# --------------------------------------
# MySQL 数据库配置
# --------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=news_db

# --------------------------------------
# MinIO 对象存储配置
# --------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NEWS=news-bucket
MINIO_SECURE=false

# --------------------------------------
# Milvus 向量数据库配置
# --------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=news_collection

# --------------------------------------
# 飞书机器人配置（可选，使用飞书功能时必填）
# --------------------------------------
# 从飞书开发者平台 https://open.feishu.cn/ 获取
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_VERIFICATION_TOKEN=your_verification_token

# --------------------------------------
# 爬虫配置
# --------------------------------------
CRAWL_INTERVAL=3600
CRAWL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
CRAWL_DELAY=1

# --------------------------------------
# 应用配置
# --------------------------------------
DEBUG=true
LOG_LEVEL=INFO
